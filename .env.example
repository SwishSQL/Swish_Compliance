# =====================================================================
# Swish Compliance (SQL Server edition) — environment configuration
# Copy this file to `.env.local` for local dev, or set these on the host.
# =====================================================================

# --- REQUIRED ---------------------------------------------------------

# Microsoft SQL Server connection. Two formats are accepted.
#
#   1. URL form (what the examples below use):
#        mssql://user:password@host:1433/database
#      Optional query flags, both defaulting sensibly by host:
#        ?encrypt=true|false                 (default: false for localhost)
#        &trustServerCertificate=true|false  (default: true  for localhost)
#
#   2. A native SQL Server connection string, passed through untouched:
#        Server=host,1433;Database=db;User Id=sa;Password=...;Encrypt=true;
#
# Local SQL Server / Docker:
DATABASE_URL=mssql://sa:YourStrong%40Passw0rd@localhost:1433/swish_compliance
#
# Azure SQL / hosted (encryption on, real certificate):
#   DATABASE_URL=mssql://user:pass@myserver.database.windows.net:1433/swish_compliance?encrypt=true&trustServerCertificate=false
#
# Note: the password is URL-decoded, so percent-encode any reserved
# characters — '@' becomes %40, ':' becomes %3A, '/' becomes %2F.

# Secret used to sign session JWT cookies. MUST be >= 16 chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- OPTIONAL ---------------------------------------------------------

# Node environment. Set to 'production' on hosted deploys (enables secure
# cookies and disables Vite/Next dev tooling).
NODE_ENV=development

# Bootstrap admin user — used ONLY by `npm run db:migrate` when the users
# table is empty. After the first login, change the password from the UI
# (or insert your real users directly).
ADMIN_EMAIL=admin@swish.local
ADMIN_PASSWORD=admin123
